{
  "minigames": [
    {
      "minigame_id": "articulation_scramble",
      "difficulty_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "The narrative prompt or instruction shown to the player."
          },
          "prefix": {
            "type": "string",
            "description": "Optional text prefix displayed before the selected word sequence."
          },
          "correct_sequence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The correct sequence of words the player must select in order."
          },
          "confuse_words": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Distractor words mixed in with the correct ones."
          },
          "max_time_seconds": {
            "type": "number",
            "description": "Optional countdown timer in seconds. Auto-submits when time expires."
          }
        },
        "required": [
          "prompt",
          "correct_sequence",
          "confuse_words"
        ]
      },
      "assets_schema": {
        "type": "object",
        "properties": {}
      },
      "events_schema": [
        "on_success",
        "on_failure",
        "on_timeout"
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the player selected the correct sequence."
          },
          "selected_sequence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The sequence of words the player selected."
          },
          "time_spent_seconds": {
            "type": "number",
            "description": "Time the player spent before submitting."
          }
        }
      }
    },
    {
      "minigame_id": "lights_out",
      "difficulty_schema": {
        "type": "object",
        "properties": {
          "grid_size": {
            "type": "integer",
            "minimum": 3,
            "maximum": 7,
            "default": 4,
            "description": "Number of rows and columns in the grid (NxN)."
          },
          "max_moves": {
            "type": "integer",
            "minimum": 1,
            "default": 20,
            "description": "Maximum moves allowed before the puzzle is failed."
          },
          "scramble_depth": {
            "type": "integer",
            "minimum": 1,
            "default": 10,
            "description": "Number of random moves applied from the solved state to generate the puzzle."
          }
        }
      },
      "assets_schema": {
        "type": "object",
        "properties": {
          "icon_on": {
            "type": "string",
            "default": "💡",
            "description": "Emoji or short string displayed for a lit cell."
          },
          "icon_off": {
            "type": "string",
            "default": "⬛",
            "description": "Emoji or short string displayed for an unlit cell."
          }
        }
      },
      "events_schema": [
        "on_combo",
        "on_near_miss"
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "moves_made": {
            "type": "integer",
            "description": "Total moves the player made."
          },
          "grid_remaining": {
            "type": "integer",
            "description": "Number of lit cells remaining when the game ended."
          }
        }
      }
    },
    {
      "minigame_id": "reflex_dial",
      "difficulty_schema": {
        "type": "object",
        "properties": {
          "indicator_speed": {
            "type": "number",
            "minimum": 0.1,
            "default": 1,
            "description": "Rotations per second of the dial needle."
          },
          "zone_width_degrees": {
            "type": "number",
            "minimum": 5,
            "maximum": 180,
            "default": 40,
            "description": "Width of the success zone in degrees."
          },
          "required_success_hits": {
            "type": "integer",
            "minimum": 1,
            "default": 3,
            "description": "Number of successful hits required to win."
          },
          "key_sequence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional key names the player must press per hit (e.g. ArrowUp, ArrowDown)."
          }
        },
        "required": [
          "indicator_speed",
          "zone_width_degrees",
          "required_success_hits"
        ]
      },
      "assets_schema": {
        "type": "object",
        "properties": {}
      },
      "events_schema": [
        "on_hit",
        "on_miss",
        "on_success",
        "on_failure"
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the player achieved the required hits."
          },
          "hits": {
            "type": "integer",
            "description": "Number of successful hits."
          },
          "misses": {
            "type": "integer",
            "description": "Number of misses."
          },
          "avg_reaction_time_ms": {
            "type": "number",
            "description": "Average reaction time in milliseconds for successful hits."
          }
        }
      }
    }
  ]
}
