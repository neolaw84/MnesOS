{
  "minigame_id": "reflex_dial",
  "difficulty_schema": {
    "type": "object",
    "properties": {
      "indicator_speed": {
        "type": "number",
        "minimum": 0.1,
        "default": 1,
        "description": "Rotations per second of the dial needle."
      },
      "zone_width_degrees": {
        "type": "number",
        "minimum": 5,
        "maximum": 180,
        "default": 40,
        "description": "Width of the success zone in degrees."
      },
      "required_success_hits": {
        "type": "integer",
        "minimum": 1,
        "default": 3,
        "description": "Number of successful hits required to win."
      },
      "key_sequence": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Optional key names the player must press per hit (e.g. ArrowUp, ArrowDown)."
      }
    },
    "required": ["indicator_speed", "zone_width_degrees", "required_success_hits"]
  },
  "assets_schema": {
    "type": "object",
    "properties": {}
  },
  "events_schema": ["on_hit", "on_miss", "on_success", "on_failure"],
  "output_schema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "description": "Whether the player achieved the required hits."
      },
      "hits": {
        "type": "integer",
        "description": "Number of successful hits."
      },
      "misses": {
        "type": "integer",
        "description": "Number of misses."
      },
      "avg_reaction_time_ms": {
        "type": "number",
        "description": "Average reaction time in milliseconds for successful hits."
      }
    }
  }
}
